{
  "name": "@appbana/security-redaction",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-based input redactor shared by every AI adapter. Runs BEFORE any network call and produces the `AIProvenanceRedaction[]` array recorded on the provenance record. Traces to ADR-015 § Redaction and ADR-017 check.privacy-validation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --experimental-strip-types __tests__/redact.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@appbana/adapter-ai-contract": "file:../adapter-ai-contract"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
