{
  "name": "@appbana/ai-adapter-conformance-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable conformance test runner for AppBana Genesis AI Model adapters. Every registered adapter (Claude, local Llama, …) MUST pass the tier its capabilities declare. Traces to ADR-015 § Conformance Suite and ADR-017 check.ai-governance.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm run build && node --test --experimental-strip-types \"__tests__/*.test.ts\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@appbana/adapter-ai-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
