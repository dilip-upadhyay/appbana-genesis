{
  "name": "@appbana/adapter-ai-local-llama",
  "version": "0.1.0",
  "private": true,
  "description": "AI model adapter targeting a locally hosted Llama 3.3 70B (llama.cpp server / vLLM / Ollama). Air-gapped-friendly: requiresNetwork=false, egressesInputsToThirdParty=false.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"__tests__/*.test.ts\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@appbana/adapter-ai-contract": "file:../adapter-ai-contract",
    "@appbana/security-redaction": "file:../security-redaction"
  },
  "devDependencies": {
    "@appbana/ai-adapter-conformance-suite": "file:../ai-adapter-conformance-suite",
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "typescript": "5.6.3"
  }
}
