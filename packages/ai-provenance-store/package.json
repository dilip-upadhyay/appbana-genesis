{
  "name": "@appbana/ai-provenance-store",
  "version": "0.1.0",
  "private": true,
  "description": "Append-only store for AIProvenanceRecord. Ships an in-memory backend, a JSONL file backend, and a Postgres backend (requires the optional `pg` peer dep). Includes a kernel-side `assertProvenance` guard that refuses AI outputs without a valid provenance record.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sql",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm run build && node --test --experimental-strip-types \"__tests__/*.test.ts\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@appbana/adapter-ai-contract": "workspace:*"
  },
  "devDependencies": {
    "@appbana/prompt-template-registry": "workspace:*",
    "@appbana/security-redaction": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "pg-mem": "^3.0.14",
    "rimraf": "^6.0.1",
    "typescript": "5.6.3"
  },
  "optionalDependencies": {
    "pg": "^8.22.0"
  },
  "peerDependencies": {
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
