{
  "name": "@appbana/adapter-ai-anthropic-claude",
  "version": "0.1.0",
  "private": true,
  "description": "AI Model Adapter for Anthropic Claude — text-generation and structured-output kinds. Reference cloud adapter for AppBana Genesis. Traces to ADR-015 and passes @appbana/ai-adapter-conformance-suite Tier B.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --experimental-strip-types __tests__/*.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@appbana/adapter-ai-contract": "file:../adapter-ai-contract",
    "@appbana/security-redaction": "file:../security-redaction"
  },
  "devDependencies": {
    "@appbana/ai-adapter-conformance-suite": "file:../ai-adapter-conformance-suite",
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
